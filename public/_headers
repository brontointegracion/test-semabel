# Encabezados de los archivos estáticos (no se aplican a las respuestas que genera el Worker, que ya llevan los suyos).
/*
  Referrer-Policy: no-referrer
  X-Content-Type-Options: nosniff
  Permissions-Policy: camera=(), microphone=(), geolocation=()
  Content-Security-Policy: default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src 'self' https://ipwho.is; manifest-src 'self'; worker-src 'self'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'; object-src 'none'

/anthony/*
  X-Robots-Tag: noindex
  Cache-Control: no-store

/control/*
  X-Robots-Tag: noindex
  Cache-Control: no-store

# Pantallas del organizador (REPORT_184): mismas protecciones que /anthony/* y /control/*, para las direcciones antiguas (/anthony),
# las canónicas (/organizador), la entrada amable (/ligas) y el alias del piloto (/deportivo-vip/ligas). El comodín «/x/*» no cubre «/x»:
# por eso /anthony, /organizador, /ligas y el alias se declaran también exactos, con y sin barra final donde la aplicación los acepta.
# No afecta a /v1/* (lo contesta el Worker con sus propios encabezados) ni a /assets/* (archivos con huella, que sí se guardan en caché).
/anthony
  X-Robots-Tag: noindex
  Cache-Control: no-store

/organizador
  X-Robots-Tag: noindex
  Cache-Control: no-store

/organizador/*
  X-Robots-Tag: noindex
  Cache-Control: no-store

/ligas
  X-Robots-Tag: noindex
  Cache-Control: no-store

/ligas/
  X-Robots-Tag: noindex
  Cache-Control: no-store

/deportivo-vip/ligas
  X-Robots-Tag: noindex
  Cache-Control: no-store

/deportivo-vip/ligas/
  X-Robots-Tag: noindex
  Cache-Control: no-store
